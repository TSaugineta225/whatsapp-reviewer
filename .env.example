# =============================================================================
# YANE BOT — Variáveis de ambiente
# =============================================================================
#
# Copia este ficheiro para `.env` e preenche os valores:
#
#     cp .env.example .env
#
# Em produção, define estas variáveis directamente no ambiente
# (Cloud Run, Kubernetes Secrets, etc.) — o `.env` não é usado.
#
# Secções:
#   1. AMBIENTE
#   2. REDIS
#   3. API PYTHON (Yane ATS)
#   4. BOT / WHATSAPP
#   5. MÉTRICAS
#   6. LOGGING

# =============================================================================
# 1. AMBIENTE
# =============================================================================

# development | staging | production
# Controla validações, defaults e nível de log.
NODE_ENV=development

# Nível de log: debug | info | warn | error
# Em produção o default é "info"; em desenvolvimento é "debug".
LOG_LEVEL=debug

# Porta do servidor HTTP
PORT=3000

# Bind do bot quando corre fora de Docker.
# 127.0.0.1 → apenas acessível da própria máquina (dev seguro)
# 0.0.0.0   → acessível da rede (só se souberes o que estás a fazer)
BOT_BIND_HOST=127.0.0.1

# =============================================================================
# 2. REDIS
# =============================================================================

# Dev local (Redis no Windows/WSL, a correr em localhost):
#   REDIS_URL=redis://:password@localhost:6379/0
#
# Dev em Docker, com Redis em Docker (serviço `redis` do compose):
#   REDIS_URL=redis://:password@redis:6379/0
#
# Dev em Docker, com Redis a correr no Windows:
#   REDIS_URL=redis://:password@host.docker.internal:6379/0
#
# Produção (Memorystore, Upstash, etc.):
#   REDIS_URL=redis://:password@10.0.0.3:6379/0
REDIS_URL=redis://:redis_yane_2026_forte@redis:6379/0

# Prefixo das chaves Redis (permite partilhar a mesma instância)
REDIS_PREFIX=yane

# =============================================================================
# 3. API PYTHON (Yane ATS)
# =============================================================================

# URL base do backend Python.
#
# ⚠️  DEVE incluir o prefixo `/api` (ou `/api/v1`), porque o serviço
#     anexa `/interviews/...`, `/health`, etc. directamente.
#
# Dev local (Python no Windows, bot no Windows):
#   YANE_API_URL=http://localhost:8000/api
#
# Dev em Docker (bot em Docker, Python no Windows):
#   YANE_API_URL=http://host.docker.internal:8000/api
#
# Produção (bot e Python no Cloud Run):
#   YANE_API_URL=https://api.yane.co.mz/api
YANE_API_URL=http://host.docker.internal:8000/api

# Token partilhado com o backend Python.
# TEM DE SER IDÊNTICO ao YANE_SERVICE_TOKEN do Python.
# Gera um valor único por ambiente (>= 32 caracteres em produção).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
YANE_SERVICE_TOKEN=troca_por_token_igual_ao_do_python

# API key opcional (alguns backends aceitam X-API-Key em vez de Bearer).
# Se não usares, deixa vazio.
YANE_API_KEY=

# Timeouts por operação (em milissegundos).
# Só precisas de mexer se notares timeouts recorrentes.
YANE_API_TIMEOUT=15000
YANE_TURN_TIMEOUT=300000
YANE_LOOKUP_TIMEOUT=10000
YANE_STATUS_TIMEOUT=5000
YANE_HEALTH_TIMEOUT=3000

# =============================================================================
# 4. BOT / WHATSAPP
# =============================================================================

# Secret partilhado para assinar/validar chamadas do Python → bot.
# Em setups antigos servia de fallback do YANE_SERVICE_TOKEN.
# Hoje é opcional — só preenche se o backend o exigir.
WHATSAPP_BOT_SECRET=

# Código de país por omissão para normalizar números.
DEFAULT_COUNTRY_CODE=258

# Comportamento das "bolhas" de digitação no WhatsApp.
WHATSAPP_TYPING_MS_PER_CHAR=22
WHATSAPP_TYPING_MAX_MS=2600

# =============================================================================
# 5. MÉTRICAS (Prometheus)
# =============================================================================

# Token para proteger o endpoint /metrics.
# Se vazio, /metrics fica público — aceitável em dev, inseguro em prod.
METRICS_TOKEN=

# =============================================================================
# 6. NOTAS PARA PRODUÇÃO
# =============================================================================
#
# Antes de fazer deploy em produção, confirma:
#
#   [ ] NODE_ENV=production
#   [ ] YANE_API_URL usa https://
#   [ ] YANE_SERVICE_TOKEN tem >= 32 caracteres (aleatório)
#   [ ] REDIS_URL aponta para Redis gerido (Memorystore, Upstash)
#   [ ] METRICS_TOKEN definido (ou /metrics exposto atrás de firewall)
#   [ ] LOG_LEVEL=info (não debug)
#
# O `env.js` aborta o arranque se alguma destas condições falhar.